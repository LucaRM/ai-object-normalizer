# ========================================================
# HIGH-RELIABILITY CASCADING AI PROVIDERS (Zero Credit Card Required):
# 1. Pollinations: Keyless Free AI (Active by default, NO key or signup required)
# 2. OVH Free Llama 3.3 70B: Keyless Free AI (Active by default)
# 3. Cerebras: 1,000,000 Free Tokens/day, 1800+ tok/s: https://cloud.cerebras.ai
# 4. SambaNova: Free Developer Tier (Llama 3.3 70B, Qwen): https://cloud.sambanova.ai
# 5. GitHub Models: Free GPT-4o-mini / Llama 3.3 with any GitHub Token: https://github.com/settings/tokens
# 6. Mistral AI: 1 Billion Free Tokens/month on Experimenter Tier: https://console.mistral.ai
# 7. Google Gemini: Free API key (1,500 req/day): https://aistudio.google.com/app/apikey
# 8. Groq: Free API key (14,400 req/day): https://console.groq.com/keys
# 9. OpenRouter: Free models (:free): https://openrouter.ai/keys
# 10. Cohere: 1,000 Free calls/month trial: https://dashboard.cohere.com/api-keys
# 11. Hugging Face: Free Serverless Router token: https://huggingface.co/settings/tokens
# 12. Ollama: Free local offline LLM: winget install Ollama.Ollama
# ========================================================

PORT=3009

# --------------------------------------------------------
# 1. Zero-Setup Keyless Free AI (Active automatically)
# --------------------------------------------------------
POLLINATIONS_MODEL=openai

# --------------------------------------------------------
# 2. Ultra-Fast High Volume Free Tiers (No Credit Card)
# --------------------------------------------------------
# Groq Cloud (Free Tier - 30 RPM, 14,400 req/day): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras (1,000,000 Free Tokens/Day, 1800+ tok/s): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# SambaNova Cloud (Free Developer Tier - Llama 3.3 70B): https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Google AI Studio (15 RPM, 1500 req/day): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# GitHub Models (Free GPT-4o-mini, Llama 3.3 70B via standard GitHub Personal Access Token):
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o-mini

# Mistral AI (1 Billion Free Tokens/Month on Experimenter Tier): https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# DeepSeek (DeepSeek V3 / R1 high precision extraction): https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (Aggregates dozens of rotating :free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Cohere (1,000 Free Calls/Month Trial, No CC): https://dashboard.cohere.com
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024

# Hugging Face Serverless (Free User Access Token): https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --------------------------------------------------------
# 3. Commercial / Paid Cloud Providers (Optional)
# --------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --------------------------------------------------------
# 4. Local Offline Ollama (100% Free, Private & Offline)
# --------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --------------------------------------------------------
# 5. Pacing and Cooldown Controls
# --------------------------------------------------------
# Minimum interval in ms between consecutive calls to the same external AI provider
PROVIDER_MIN_INTERVAL_MS=1500

# Cooldown duration for short burst rate limits without explicit retry headers (default 60s)
DEFAULT_COOLDOWN_SECONDS=60

# Daily cooldown duration when a provider exhausts daily quota (default: auto-calculates until midnight UTC)
# DAILY_COOLDOWN_SECONDS=86400

# --------------------------------------------------------
# 6. Database Configuration (Optional Persistent Store)
# --------------------------------------------------------
# Set to false to disable database persistence entirely (defaults to true)
DATABASE_ENABLED=true

# MongoDB URI (defaults to mongodb://127.0.0.1:27017)
# If MongoDB is unavailable or offline, automatically falls back to local JSON file!
MONGODB_URI=mongodb://127.0.0.1:27017

# Local JSON fallback storage path (zero external dependencies)
PROVIDER_STORE_PATH=./data/providers-db.json

# Default Book ObjectId for RPG entities (e.g. 5e core rules)
DEFAULT_BOOK_ID=68e065e63483269c7c88180d
