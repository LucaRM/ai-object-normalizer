# ========================================================
# FREE AI OPTIONS (Zero Credit Card Required):
# 1. Pollinations (Active by default, NO key or signup required)
# 2. Google Gemini: Free API key (1,500 req/day): https://aistudio.google.com/app/apikey
# 3. Groq: Free API key (14,400 req/day): https://console.groq.com/keys
# 4. OpenRouter: Free models (:free): https://openrouter.ai/keys
# 5. Ollama: Free local offline LLM (winget install Ollama.Ollama)
# ========================================================

PORT=3009

# 1. Free Keyless AI (Active automatically)
POLLINATIONS_MODEL=openai

# 2. Google AI Studio (100% Free Forever Tier - 15 RPM, 1500 req/day, No CC)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3. Groq Cloud (100% Free Tier - 30 RPM, 14400 req/day, 300 t/s LLaMA 3.3, No CC)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. OpenRouter (Free :free models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5. Paid / Commercial Cloud Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 6. Local Ollama (100% Free, Private & Offline)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Default Book ObjectId for RPG entities (e.g. 5e core rules)
DEFAULT_BOOK_ID=68e065e63483269c7c88180d
